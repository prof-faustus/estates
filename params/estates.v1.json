      { "id": "fate-06", "text": "Advance to the nearest Rail and pay the owner twice the rent due, or buy it if unowned.", "effect": { "kind": "MOVE_TO_NEAREST", "category": "station", "collect_if_pass": true, "rent_multiplier": 2 } },
