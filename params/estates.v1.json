  "rent_factors": {
    "rent_base_factor": 0.08,
    "full_group_unbuilt_multiplier": 2,
    "build_multipliers": [5, 15, 45, 62.5],
    "estate_multiplier": 75,
    "station_base": 25,
    "station_formula": "station_base * 2^(stations_owned-1)",
    "utility_factor": [4, 10],
    "utility_formula": "dice_total * utility_factor[utilities_owned-1]",
    "mortgage_value_factor": 0.5,
    "unmortgage_cost_factor": 1.1,
    "sell_building_refund_factor": 0.5
  },
  "build_supply": {
