      { "id": "fate-08", "text": "Storms damage your holdings. Pay 25 per house and 100 per estate.", "effect": { "kind": "REPAIRS", "per_house": 25, "per_estate": 100 } },
      { "id": "fate-09", "text": "Take a wrong turn. Go back three spaces.",              "effect": { "kind": "MOVE_RELATIVE", "delta": -3 } },
      { "id": "fate-10", "text": "Your work is celebrated. Collect 20 from every other player.", "effect": { "kind": "COLLECT_EACH", "amount": 20 } },
      { "id": "fate-11", "text": "Pay a toll of 50.",                                      "effect": { "kind": "PAY_BANK", "amount": 50 } },
      { "id": "fate-12", "text": "Advance to Merchant Quay.",                              "effect": { "kind": "MOVE_TO", "space": 26, "collect_if_pass": true } }
    ],
    "Treasury": [
      { "id": "trea-01", "text": "Proceed to The Gate to collect your due.",              "effect": { "kind": "MOVE_TO", "space": 0, "collect_if_pass": true } },
      { "id": "trea-02", "text": "An old debt is repaid to you. Collect 100.",            "effect": { "kind": "COLLECT_BANK", "amount": 100 } },
      { "id": "trea-03", "text": "Settle an outstanding charge. Pay 50.",                 "effect": { "kind": "PAY_BANK", "amount": 50 } },
      { "id": "trea-04", "text": "You are granted a writ of Reprieve. Keep it.",          "effect": { "kind": "REPRIEVE_GRANT" } },
      { "id": "trea-05", "text": "Report to the Holding Yard.",                           "effect": { "kind": "GOTO_HOLDING" } },
      { "id": "trea-06", "text": "A collection is taken in your favour. Collect 25 from every other player.", "effect": { "kind": "COLLECT_EACH", "amount": 25 } },
      { "id": "trea-07", "text": "Pay a levy of 100.",                                     "effect": { "kind": "PAY_BANK", "amount": 100 } },
      { "id": "trea-08", "text": "A small windfall. Collect 45.",                          "effect": { "kind": "COLLECT_BANK", "amount": 45 } },
      { "id": "trea-09", "text": "Civic upkeep is assessed. Pay 40 per house and 115 per estate.", "effect": { "kind": "REPAIRS", "per_house": 40, "per_estate": 115 } },
      { "id": "trea-10", "text": "Stand a round for the table. Pay each player 10.",       "effect": { "kind": "PAY_EACH", "amount": 10 } },
      { "id": "trea-11", "text": "A bequest arrives. Collect 125.",                        "effect": { "kind": "COLLECT_BANK", "amount": 125 } },
      { "id": "trea-12", "text": "Pay a duty of 150.",                                     "effect": { "kind": "PAY_BANK", "amount": 150 } }
