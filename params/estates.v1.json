{
  "$schema": "./estates.params.schema.json",
  "params_version": "estates.v1",
  "description": "ESTATES — single source of truth for all game parameters. Rents are DERIVED from base_price + factors (never stored independently). No value in this file may be hard-coded elsewhere. Original, non-copyright content only.",
  "unit": "sat",
  "money_model": "native-satoshi",
  "network_modes": ["mainnet", "testnet", "regtest"],
  "scalars": {
    "starting_balance_per_seat": 1500,
    "salary": 200,
    "max_seats": 6,
    "min_seats": 2,
    "board_size": 40
