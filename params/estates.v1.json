    "Fate": [
      { "id": "fate-01", "text": "Advance to The Gate.",                                   "effect": { "kind": "MOVE_TO", "space": 0, "collect_if_pass": true } },
      { "id": "fate-02", "text": "Advance to Cathedral Close.",                            "effect": { "kind": "MOVE_TO", "space": 24, "collect_if_pass": true } },
      { "id": "fate-03", "text": "Report to the Holding Yard.",                            "effect": { "kind": "GOTO_HOLDING" } },
      { "id": "fate-04", "text": "A patron rewards you. Collect 150.",                      "effect": { "kind": "COLLECT_BANK", "amount": 150 } },
