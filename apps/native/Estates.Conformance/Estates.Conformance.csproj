<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Estates.Conformance</AssemblyName>
    <RootNamespace>Estates.Conformance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Estates.Core\Estates.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="estates.v1.vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="keylife-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tx-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="cardnft-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="scriptvm-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sign-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="tablemsg-vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="beacon-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
