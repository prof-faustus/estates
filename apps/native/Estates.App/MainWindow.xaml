<Window x:Class="Estates.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESTATES" Height="820" Width="1180"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="ESTATES" Foreground="{StaticResource Fg}" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="  dealerless · on-chain · multiplayer — NATIVE" Foreground="{StaticResource Accent}" FontSize="14" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
            <TextBlock x:Name="CoreStatus" Text="" Foreground="#7bd88f" FontSize="13" VerticalAlignment="Bottom" Margin="20,0,0,4"/>
        </StackPanel>

        <!-- body: board (left) + controls/log (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="10" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BoardList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Run a deterministic demo game" Foreground="{StaticResource Fg}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="players" Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SeatCount" Width="60" SelectedIndex="1">
                            <ComboBoxItem>2</ComboBoxItem><ComboBoxItem>3</ComboBoxItem><ComboBoxItem>4</ComboBoxItem>
                            <ComboBoxItem>5</ComboBoxItem><ComboBoxItem>6</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="PlayBtn" Content="Deal &amp; play" Margin="12,0,0,0" Click="Play_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ResultLine" Text="" Foreground="{StaticResource Accent}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBox x:Name="LogBox" IsReadOnly="True" Background="#171819" Foreground="#cfd2d6"
                             FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="8"/>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="Footer" Margin="0,10,0,0" Foreground="#8a8d92" FontSize="12"
                   Text="Native estates.exe — runs the same audited engine as the web app (byte-for-byte)."/>
    </Grid>
</Window>
