<Window x:Class="Estates.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESTATES" Height="860" Width="1280" Icon="appicon.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="4,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="network" Foreground="#9aa0a6" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="Network" SelectedIndex="0" Width="130" VerticalAlignment="Center">
                    <ComboBoxItem>mainnet</ComboBoxItem><ComboBoxItem>testnet</ComboBoxItem><ComboBoxItem>regtest</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="Wordmark" Text="ESTATES" Foreground="{StaticResource Fg}" FontSize="24" FontWeight="Bold"/>
        </DockPanel>

        <TabControl x:Name="Tabs" Background="{StaticResource Bg}" BorderThickness="0" Padding="0">
            <!-- LOBBY -->
            <TabItem Header="Lobby">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10" Padding="18" Margin="0,0,16,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="On the network now" Foreground="{StaticResource Fg}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock DockPanel.Dock="Top" x:Name="LobbyStatus" Text="" Foreground="#9aa0a6" FontSize="12" Margin="0,6,0,14" TextWrapping="Wrap"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="NodeList"/></ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock Text="players" Foreground="#9aa0a6" FontSize="11"/>
                            <ComboBox x:Name="SeatCount" SelectedIndex="0" Margin="0,2,0,14">
                                <ComboBoxItem>2</ComboBoxItem><ComboBoxItem>3</ComboBoxItem><ComboBoxItem>4</ComboBoxItem><ComboBoxItem>5</ComboBoxItem><ComboBoxItem>6</ComboBoxItem>
                            </ComboBox>
                            <Button Content="Start the game" Click="Start_Click" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                            <Button Content="Join" Click="Join_Click" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                            <Button Content="Run a bot" Click="RunBot_Click" HorizontalAlignment="Stretch"/>
                            <TextBlock x:Name="StartMsg" Text="" Foreground="#f7a8c4" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- GAME -->
            <TabItem Header="Game"><ContentControl x:Name="GameHost"/></TabItem>

            <!-- WALLET -->
            <TabItem Header="Wallet"><ContentControl x:Name="WalletHost"/></TabItem>

            <!-- CHAT -->
            <TabItem Header="Chat"><ContentControl x:Name="ChatHost"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>
