<Window x:Class="Estates.App.BotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ESTATES · automated bot" Height="640" Width="360" Icon="appicon.ico"
        Background="#1a1206" WindowStartupLocation="Manual" Topmost="False"
        ResizeMode="CanMinimize" ShowInTaskbar="True">
    <!-- A BOT — fully automated, NOT a person. Narrow amber console, docked to a screen corner, never
         over the player window. The human can fund it (Funds), watch it, and End it. It never fakes a
         solo game; it plays its seat only inside a real funded on-chain game. -->
    <StackPanel Margin="14">
        <TextBlock Text="🤖 AUTOMATED BOT" Foreground="#f5a623" FontSize="16" FontWeight="Bold"/>
        <TextBlock x:Name="BotStatus" Foreground="#ffd54f" FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap"/>

        <TabControl Background="#1a1206" BorderThickness="0">
            <TabItem Header="Funds">
                <StackPanel Margin="8">
                    <TextBlock x:Name="BotWallet" Foreground="#7bd88f" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Fund the bot — import a coin you control (txid / vout / sat):" Foreground="#b8a98a" FontSize="11" TextWrapping="Wrap"/>
                    <TextBox x:Name="FundTxid" Background="#0f0a03" Foreground="#cfc4ad" FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="6" Margin="0,4,0,4"/>
                    <TextBox x:Name="FundVout" Background="#0f0a03" Foreground="#cfc4ad" FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="6" Margin="0,0,0,4" Text="0"/>
                    <TextBox x:Name="FundSat" Background="#0f0a03" Foreground="#cfc4ad" FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="6" Margin="0,0,0,4"/>
                    <Button x:Name="FundBtn" Content="Import coin" HorizontalAlignment="Left" Click="Fund_Click"/>
                    <TextBlock x:Name="FundMsg" Foreground="#f5a623" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Log">
                <TextBox x:Name="BotLog" IsReadOnly="True" Background="#0f0a03" Foreground="#cfc4ad"
                         FontFamily="Consolas" FontSize="11" Height="360" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="8"/>
            </TabItem>
        </TabControl>

        <Button x:Name="EndBtn" Content="End bot" Click="End_Click" Background="#5a2d12" Foreground="#ffd54f"
                HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,6,0,6"/>
    </StackPanel>
</Window>
