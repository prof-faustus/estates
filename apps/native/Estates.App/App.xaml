<Application x:Class="Estates.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#1e1f22"/>
        <SolidColorBrush x:Key="Panel" Color="#2b2d31"/>
        <SolidColorBrush x:Key="Fg" Color="#e6e6e6"/>
        <SolidColorBrush x:Key="Accent" Color="#f5a623"/>
        <SolidColorBrush x:Key="Green" Color="#2e7d32"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Green}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
