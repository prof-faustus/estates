<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AssemblyName>estates</AssemblyName>            <!-- the double-click estates.exe -->
    <RootNamespace>Estates.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- a real custom icon: gives estates.exe its own identity AND stops the default-icon AV heuristic -->
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <!-- self-contained single-file publish: one estates.exe, no runtime install -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Estates.Core\Estates.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the window icon (pack URI "appicon.ico" resolves to this resource) -->
    <Resource Include="appicon.ico" />
  </ItemGroup>

</Project>
