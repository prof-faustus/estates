{
  "name": "@estates/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ESTATES bot policies (cautious/balanced/aggressive) as turn-driver Deciders with an independent secp256k1 signing identity. The daemon runs a bot as a SEPARATE remote player (own wallet) connected over the relay socket — never inside another player's app.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./daemon": "./src/daemon.ts"
  },
  "bin": {
    "estates-bot": "./src/daemon.ts"
  },
  "dependencies": {
    "@estates/params": "workspace:*",
    "@estates/engine": "workspace:*",
    "@estates/turn": "workspace:*",
    "@estates/trade": "workspace:*",
    "@estates/table": "workspace:*",
    "@estates/chat": "workspace:*",
    "@estates/wallet": "workspace:*"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "daemon": "node --experimental-strip-types src/daemon.ts",
    "smoke": "node --experimental-strip-types smoke-daemon.ts"
  }
}
